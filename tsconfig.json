{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "basedUrl": ".",
  "path": {
    "@/*": ["src/*"],
    "@apis/*": ["src/apis/*"],
    "@assets/*": ["src/assets/*"],
    "@compoents/*": ["src/compoents/*"],
    "@pages/*": ["src/pages/*"],
    "@routes/*": ["src/routes/*"],
    "@stores/*": ["src/stores/*"],
    "@types/*": ["src/types/*"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "exclude": [
    "node_modules",
    "**/build",
    "**/dist",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "public",
    "**/eslint.config.js"
  ]
}
